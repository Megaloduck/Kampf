<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:views="using:Kampf.Views"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="880"
             x:Class="Kampf.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource BgBrush}">

    <!-- rail | navigator | splitter | workspace | splitter | review queue -->
    <Grid x:Name="RootLayout"
          RowDefinitions="Auto,*"
          ColumnDefinitions="Auto,268,6,*,6,330">

        <!-- ============================================================ header -->
        <Border x:Name="HeaderBar"
                Grid.Row="0" Grid.ColumnSpan="6"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,9"
                PointerPressed="OnHeaderPointerPressed"
                DoubleTapped="OnHeaderDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#8FA6FF"/>
                                <GradientStop Offset="0.55" Color="#C084FC"/>
                                <GradientStop Offset="1" Color="#4FD1C5"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Classes="icon"
                                   FontSize="15"
                                   Text="{x:Static controls:Symbols.Hub}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="KAMPF"
                               FontSize="15"
                               FontWeight="Bold"
                               LetterSpacing="3.4"
                               VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource PanelAltBrush}"
                            CornerRadius="4"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="LOCAL VAULT"
                                   FontSize="9"
                                   LetterSpacing="1.1"
                                   Foreground="{DynamicResource FaintBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Working..."
                               Classes="meta"
                               FontSize="10.5"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               IsVisible="{Binding IsBusy}"/>

                   

                    <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource BorderBrush}"/>

                    <Button x:Name="NavigatorToggleButton"
                            Classes="ghost iconButton"
                            Click="OnToggleNavigatorClick"
                            ToolTip.Tip="Hide the navigator">
                        <TextBlock x:Name="NavigatorToggleIcon"
                                   Classes="icon"
                                   FontSize="18"
                                   Text="{x:Static controls:Symbols.LeftPanelClose}"/>
                    </Button>
                    <Button x:Name="ReviewToggleButton"
                            Classes="ghost iconButton"
                            Click="OnToggleReviewClick"
                            ToolTip.Tip="Hide the review queue">
                        <TextBlock x:Name="ReviewToggleIcon"
                                   Classes="icon"
                                   FontSize="18"
                                   Text="{x:Static controls:Symbols.RightPanelClose}"/>
                    </Button>

                    <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource BorderBrush}"/>
                    
                    <Button Classes="ghost iconButton"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{Binding ThemeButtonLabel}">
                        <Panel>
                            <TextBlock Classes="icon"
                                       FontSize="18"
                                       Text="{x:Static controls:Symbols.LightMode}"
                                       IsVisible="{Binding IsDarkTheme}"/>
                            <TextBlock Classes="icon"
                                       FontSize="18"
                                       Text="{x:Static controls:Symbols.DarkMode}"
                                       IsVisible="{Binding !IsDarkTheme}"/>
                        </Panel>
                    </Button>
                    
                    <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource BorderBrush}"/>

                    <!-- Minimize / maximize / close, in the header's top-right
                         corner: the window is drawn without system chrome. -->
                    <views:WindowControls Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== icon rail ================================ -->
        <views:WorkspaceRail Grid.Row="1" Grid.Column="0"/>

        <!-- ========================================================= navigator -->
        <views:NavigatorView x:Name="NavigatorPanel"
                             Grid.Row="1"
                             Grid.Column="1"/>
        <GridSplitter Grid.Row="1" Grid.Column="2"
                      x:Name="NavigatorSplitter"
                      Background="Transparent"
                      ResizeDirection="Columns"/>

        <!-- ========================================================= workspace -->
        <Grid Grid.Row="1" Grid.Column="3">
            <!-- Library landing: shown when the rail's Library entry has nothing open. -->
            <Border IsVisible="{Binding IsLibraryView}" Padding="40">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            MaxWidth="430">
                    <TextBlock Classes="icon"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Text="{x:Static controls:Symbols.Library}"
                               Foreground="{DynamicResource FaintBrush}"/>
                    <TextBlock Text="Nothing open"
                               FontSize="17"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose a note or a paper in the navigator, or start something new. Notes are markdown, and [[Title]] connects them."
                               Classes="muted"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                        <Button Classes="primary" Command="{Binding NewNoteCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.NoteAdd}"
                                           Foreground="{DynamicResource OnAccentBrush}"/>
                                <TextBlock Text="New note"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportPdfCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.UploadFile}"/>
                                <TextBlock Text="Import PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <views:ExtensionView/>
            <views:TrashView/>

            <views:NoteView x:Name="NoteEditor"/>
            <views:ReaderView/>
            <views:GraphView/>
            <views:ChatView/>
            <views:LlmConfigView/>
            <views:DataSharingView/>
            <views:SettingsView/>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="4"
                      x:Name="ReviewSplitter"
                      Background="Transparent"
                      ResizeDirection="Columns"/>

        <!-- ====================================================== right panel -->
        <Border Grid.Row="1" Grid.Column="5"
                x:Name="ReviewPanel"
                MinWidth="240"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="14,14,14,10" Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="REVIEW QUEUE" Classes="section" VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="{DynamicResource AccentDarkBrush}"
                                CornerRadius="9"
                                Padding="7,1"
                                MinWidth="20">
                            <TextBlock Text="{Binding PendingCount}"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Suggestions wait here. Nothing touches your graph until you accept it."
                               Classes="meta"
                               FontSize="10.5"
                               TextWrapping="Wrap"/>
                    <Button Classes="ghost"
                            FontSize="11"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            Command="{Binding SuggestConnectionsCommand}"
                            ToolTip.Tip="Look for related notes and tags; everything lands in the queue for review">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon"
                                       FontSize="14"
                                       Text="{x:Static controls:Symbols.AutoAwesome}"/>
                            <TextBlock Text="Find connections"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Suggestions}" Margin="12,0,12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SuggestionRowViewModel">
                                <Border Background="{DynamicResource PanelAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="11,10"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="9.5"
                                                       LetterSpacing="1"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AgeLabel}"
                                                       Classes="meta"
                                                       FontSize="10"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   IsVisible="{Binding HasDetail}"
                                                   Classes="meta"
                                                   FontSize="10.5"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="primary"
                                                    FontSize="11"
                                                    Padding="10,3"
                                                    Command="{Binding AcceptCommand}"
                                                    ToolTip.Tip="Accept this suggestion into the graph">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="icon"
                                                               FontSize="14"
                                                               Text="{x:Static controls:Symbols.Check}"
                                                               Foreground="{DynamicResource OnAccentBrush}"/>
                                                    <TextBlock Text="Accept"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="ghost"
                                                    FontSize="11"
                                                    Padding="10,3"
                                                    Command="{Binding RejectCommand}"
                                                    ToolTip.Tip="Reject this suggestion">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="icon"
                                                               FontSize="14"
                                                               Text="{x:Static controls:Symbols.Close}"/>
                                                    <TextBlock Text="Reject"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10"
                        MaxHeight="220">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="ACTIVITY" Classes="section" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuditRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Detail}"
                                                       FontSize="10.5"
                                                       Classes="muted"
                                                       Margin="6,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FaintBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
