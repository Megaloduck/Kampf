<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:views="using:Kampf.Views"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="268" d:DesignHeight="720"
             x:Class="Kampf.Views.NavigatorView"
             x:DataType="vm:MainViewModel">
    <!-- Search, folders and note rows. The search box lives here rather than in the
         shell, so Ctrl+F only has to ask this control for focus. The two row visuals
         are their own controls: NavigatorFolderItem and NavigatorRowItem. -->
    <Border MinWidth="200"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,12,10,8">
                <TextBox x:Name="SearchBox"
                         Padding="10,6,9,6"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         Watermark="Search text or tag:name"
                         AutomationProperties.Name="Search notes and papers"
                         ToolTip.Tip="Search text or tag:name (Ctrl+F)"
                         KeyDown="OnSearchKeyDown">
                    <TextBox.InnerLeftContent>
                        <TextBlock Classes="icon"
                                   FontSize="15"
                                   Margin="9,0,0,0"
                                   Text="{x:Static controls:Symbols.Search}"
                                   Foreground="{DynamicResource FaintBrush}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <!-- New folder: its name is also the tag its notes carry, which is
                     what colours them in the graph. -->
                <Button x:Name="AddFolderButton"
                        Grid.Column="1"
                        Classes="ghost iconButton"
                        Margin="6,0,0,0"
                        AutomationProperties.Name="New folder"
                        ToolTip.Tip="New folder">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="210"
                                        Spacing="8"
                                        AttachedToVisualTree="OnNewFolderFlyoutOpened">
                                <TextBlock Text="NEW FOLDER"
                                           Classes="section"
                                           FontSize="11"/>
                                <TextBox Text="{Binding NewFolderName, Mode=TwoWay}"
                                         Watermark="Folder name"
                                         AutomationProperties.Name="Folder name"
                                         KeyDown="OnNewFolderKeyDown"/>
                                <Button Classes="primary"
                                        HorizontalAlignment="Right"
                                        Click="OnCreateFolderClick">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Classes="icon"
                                                   FontSize="15"
                                                   Text="{x:Static controls:Symbols.CreateNewFolder}"
                                                   Foreground="{DynamicResource OnAccentBrush}"/>
                                        <TextBlock Text="Create"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <TextBlock Classes="icon"
                               FontSize="18"
                               Text="{x:Static controls:Symbols.CreateNewFolder}"/>
                </Button>
            </Grid>

            <!-- What the search found, kept where the old list header was. -->
            <Border Grid.Row="1"
                    IsVisible="{Binding HasSearchResults}"
                    Margin="12,0,11,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ListHeader}"
                               Classes="section"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1"
                            Classes="link"
                            FontSize="12"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip.Tip="Show every note again">
                        <TextBlock Text="Clear"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding NavigatorFolders}" Margin="8,0,8,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigatorFolderViewModel">
                            <StackPanel Margin="0,0,0,3">
                                <views:NavigatorFolderItem/>

                                <ItemsControl ItemsSource="{Binding Rows}"
                                              IsVisible="{Binding IsExpanded}"
                                              Margin="18,1,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NavigatorRowViewModel">
                                            <views:NavigatorRowItem/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,8">
                <TextBlock Text="{Binding CountsSummary}"
                           Classes="meta"
                           FontSize="10"
                           TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
