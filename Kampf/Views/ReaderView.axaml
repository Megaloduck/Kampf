<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Kampf.Views.ReaderView"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsReaderView}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kampf/Views/RowTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Page card: consistent radius, subtle hover lift on the whole card. -->
        <Style Selector="Border.page">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <!-- Info toggle: same visual language as NoteView's preview toggle. -->
        <Style Selector="ToggleButton.info">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ToggleButton.info:checked">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="ToggleButton.info:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Paper reader: metadata, extracted pages and their anchored notes. -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0"
                Padding="24,16,24,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding ReaderTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReaderCitation}"
                               Classes="meta"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ReaderCitation}"/>
                    
                <!-- Action group: info toggle + destructive action, pinned top-right. -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Top">
                    <ToggleButton x:Name="InfoToggle"
                                  Classes="info"
                                  IsChecked="True"
                                  ToolTip.Tip="Show or hide paper details">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon"
                                       FontSize="15"
                                       Text="{x:Static controls:Symbols.Visibility}"/>
                            <TextBlock Text="Info"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Classes="ghost danger"
                            Command="{Binding DeleteDocumentCommand}"
                            IsEnabled="{Binding HasSelectedDocument}"
                            ToolTip.Tip="Remove this paper, its highlights and the stored PDF">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon"
                                       FontSize="16"
                                       Text="{x:Static controls:Symbols.Delete}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Delete paper"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Click twice to confirm"
                               Classes="meta"
                               FontSize="10.5"
                               Foreground="{DynamicResource WarnBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ConfirmDeleteDocument}"/>
                </StackPanel>

                    <!-- Collapsible metadata block: citation, details, abstract. -->
                    <StackPanel Spacing="6" IsVisible="{Binding #InfoToggle.IsChecked}">
                        <ItemsControl ItemsSource="{Binding ReaderDetails}"
                                      Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetadataRowViewModel">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2,18,2">
                                        <TextBlock Text="{Binding Label}"
                                                   Classes="meta"
                                                   FontSize="10.5"
                                                   Width="76"
                                                   VerticalAlignment="Top"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,6,0,0"
                                Padding="12,8"
                                CornerRadius="6"
                                Background="{DynamicResource AccentDarkBrush}"
                                IsVisible="{Binding HasReaderAbstract}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="ABSTRACT"
                                           Classes="section"
                                           FontSize="9.5"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding ReaderAbstract}"
                                           Classes="muted"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           MaxLines="4"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ReaderAbstract}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ BODY: pages + anchored notes ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="20,14">

            <!-- Pages column -->
            <ScrollViewer Grid.Column="0">
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageViewModel">
                            <Border Classes="page">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding HeaderLabel}"
                                                   Classes="section"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                FontSize="11"
                                                Padding="8,4"
                                                Click="OnCapturePageClick"
                                                ToolTip.Tip="Turn the selected text into an anchored note">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Classes="icon"
                                                           FontSize="14"
                                                           Text="{x:Static controls:Symbols.FormatQuote}"/>
                                                <TextBlock Text="Capture selection → note"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <SelectableTextBlock Text="{Binding Text}"
                                                         TextWrapping="Wrap"
                                                         FontSize="13"
                                                         LineHeight="21"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         PointerReleased="OnPageTextPointerReleased"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Anchored notes column -->
            <Border Grid.Column="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="ANCHORED NOTES" Classes="section"/>
                        <TextBlock Text="Every note here keeps the page it came from."
                                   Classes="meta"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AnchoredNotes}"
                             SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                             ItemTemplate="{StaticResource NoteRowTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11.5"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>