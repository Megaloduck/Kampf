<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Kampf.Views.ReaderView"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsReaderView}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kampf/Views/RowTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Paper reader: metadata, extracted pages and their anchored notes. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="20,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding ReaderTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReaderCitation}"
                               Classes="meta"/>
                    <ItemsControl ItemsSource="{Binding ReaderDetails}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MetadataRowViewModel">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,1,18,1">
                                    <TextBlock Text="{Binding Label}"
                                               Classes="meta"
                                               FontSize="10.5"
                                               Width="76"
                                               VerticalAlignment="Top"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="2"
                                Margin="0,6,0,0"
                                IsVisible="{Binding HasReaderAbstract}">
                        <TextBlock Text="ABSTRACT" Classes="section" FontSize="9.5"/>
                        <TextBlock Text="{Binding ReaderAbstract}"
                                   Classes="muted"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   MaxLines="4"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="Click twice to confirm"
                               Classes="meta"
                               FontSize="10.5"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ConfirmDeleteDocument}"/>
                    <Button Classes="ghost danger"
                            Command="{Binding DeleteDocumentCommand}"
                            IsEnabled="{Binding HasSelectedDocument}"
                            ToolTip.Tip="Remove this paper, its highlights and the stored PDF">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon"
                                       FontSize="16"
                                       Text="{x:Static controls:Symbols.Delete}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="Delete paper"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="16,12">
            <ScrollViewer Grid.Column="0">
                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageViewModel">
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,10,10">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding HeaderLabel}"
                                                   Classes="section"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                FontSize="11"
                                                Click="OnCapturePageClick"
                                                ToolTip.Tip="Turn the selected text into an anchored note">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Classes="icon"
                                                           FontSize="14"
                                                           Text="{x:Static controls:Symbols.FormatQuote}"/>
                                                <TextBlock Text="Capture selection → note"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <SelectableTextBlock Text="{Binding Text}"
                                                         TextWrapping="Wrap"
                                                         FontSize="13"
                                                         LineHeight="20"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         PointerReleased="OnPageTextPointerReleased"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="ANCHORED NOTES" Classes="section"/>
                        <TextBlock Text="Every note here keeps the page it came from."
                                   Classes="meta"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AnchoredNotes}"
                             SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                             ItemTemplate="{StaticResource NoteRowTemplate}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11.5"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
