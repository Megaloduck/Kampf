<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             x:Class="Kampf.Views.TrashView"
             x:DataType="vm:MainViewModel">

    <!-- Trash bin: deleting a note or a paper moves it here. Nothing in this list
         is in the vault any more — search, the graph and the navigator ignore it —
         so restoring is safe and emptying the bin is the only permanent delete. -->
    <Border IsVisible="{Binding IsTrashView}" Padding="32">
        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                <Border Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="{DynamicResource PanelAltBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Classes="icon"
                               FontSize="19"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{x:Static controls:Symbols.Delete}"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="TRASH BIN" Classes="section" LetterSpacing="2"/>
                    <TextBlock Text="{Binding TrashSummary}"
                               Classes="meta"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Classes="ghost danger"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasTrash}"
                        Command="{Binding EmptyTrashCommand}"
                        ToolTip.Tip="Delete everything in the bin (asks first)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon"
                                   FontSize="16"
                                   Text="{x:Static controls:Symbols.Delete}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Empty trash"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding TrashRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrashRowViewModel">
                            <Border Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,9"
                                    Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <TextBlock Classes="icon"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Text="{Binding Icon}"
                                               Foreground="{DynamicResource FaintBrush}"/>

                                    <StackPanel Grid.Column="1" Margin="10,0" Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       Classes="meta"
                                                       FontSize="11"
                                                       LetterSpacing="1"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeletedLabel}"
                                                       Classes="meta"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Classes="ghost"
                                            FontSize="12"
                                            Padding="10,3"
                                            Command="{Binding RestoreCommand}"
                                            ToolTip.Tip="Put this back in the vault">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Classes="icon"
                                                       FontSize="14"
                                                       Text="{x:Static controls:Symbols.Restore}"/>
                                            <TextBlock Text="Restore"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="3"
                                            Classes="ghost danger"
                                            FontSize="12"
                                            Padding="10,3"
                                            Margin="6,0,0,0"
                                            Command="{Binding DeleteForeverCommand}"
                                            ToolTip.Tip="Delete permanently (asks first, then 10 seconds to undo)">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Classes="icon"
                                                       FontSize="14"
                                                       Text="{x:Static controls:Symbols.Delete}"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock Text="Delete forever"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1"
                        IsVisible="{Binding !HasTrash}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        MaxWidth="430">
                <TextBlock Classes="icon"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           Text="{x:Static controls:Symbols.Delete}"
                           Foreground="{DynamicResource FaintBrush}"/>
                <TextBlock Text="The trash bin is empty"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Deleting a note or a paper moves it here, not out of the vault. Restore it, or empty the bin to delete it for good."
                           Classes="muted"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
