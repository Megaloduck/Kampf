<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:views="using:Kampf.Views"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="880"
             x:Class="Kampf.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource BgBrush}">

    <UserControl.Styles>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kampf/Views/RowTemplates.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootLayout" RowDefinitions="Auto,*">
        <!-- 0 sidebar | 1 splitter | 2 workspace | 3 splitter | 4 review queue -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="286"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="326"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ header -->
        <Border Grid.Row="0" Grid.ColumnSpan="5"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="KAMPF"
                               FontSize="16"
                               FontWeight="Bold"
                               LetterSpacing="3"
                               Foreground="{DynamicResource TextBrush}"/>
                    <Border Background="{DynamicResource PanelAltBrush}"
                            CornerRadius="4"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="LOCAL VAULT" FontSize="9.5" LetterSpacing="1"
                                   Foreground="{DynamicResource FaintBrush}"/>
                    </Border>
                    <Button x:Name="SidebarToggleButton"
                            Classes="ghost iconButton"
                            Click="OnToggleSidebarClick"
                            ToolTip.Tip="Hide the note list">
                        <TextBlock x:Name="SidebarToggleIcon"
                                   Classes="icon"
                                   FontSize="18"
                                   Text="{x:Static controls:Symbols.LeftPanelClose}"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CountsSummary}"
                           Classes="meta"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="UndoButton"
                                Classes="ghost iconButton"
                                Click="OnUndoClick"
                                ToolTip.Tip="Undo (Ctrl+Z)">
                            <TextBlock Classes="icon"
                                       FontSize="18"
                                       Text="{x:Static controls:Symbols.Undo}"/>
                        </Button>
                        <Button x:Name="RedoButton"
                                Classes="ghost iconButton"
                                Click="OnRedoClick"
                                ToolTip.Tip="Redo (Ctrl+Y)">
                            <TextBlock Classes="icon"
                                       FontSize="18"
                                       Text="{x:Static controls:Symbols.Redo}"/>
                        </Button>
                    </StackPanel>
                    <Button Classes="ghost iconButton"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="Settings">
                        <TextBlock Classes="icon"
                                   FontSize="19"
                                   Text="{x:Static controls:Symbols.Settings}"/>
                    </Button>
                    <Button Classes="ghost iconButton"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{Binding ThemeButtonLabel}">
                        <Panel>
                            <TextBlock Classes="icon"
                                       FontSize="19"
                                       Text="{x:Static controls:Symbols.LightMode}"
                                       IsVisible="{Binding IsDarkTheme}"/>
                            <TextBlock Classes="icon"
                                       FontSize="19"
                                       Text="{x:Static controls:Symbols.DarkMode}"
                                       IsVisible="{Binding !IsDarkTheme}"/>
                        </Panel>
                    </Button>
                    <Button Classes="ghost"
                            Command="{Binding NewNoteCommand}"
                            ToolTip.Tip="Create a new note">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon"
                                       FontSize="17"
                                       Text="{x:Static controls:Symbols.NoteAdd}"/>
                            <TextBlock Text="New note"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="primary"
                            Command="{Binding ImportPdfCommand}"
                            ToolTip.Tip="Import a PDF into the vault">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon"
                                       FontSize="17"
                                       Text="{x:Static controls:Symbols.UploadFile}"
                                       Foreground="{DynamicResource OnAccentBrush}"/>
                            <TextBlock Text="Import PDF"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1"
                            Height="20"
                            Margin="2,0"
                            Background="{DynamicResource BorderBrush}"/>
                    <Button x:Name="ReviewToggleButton"
                            Classes="ghost iconButton"
                            Click="OnToggleReviewClick"
                            ToolTip.Tip="Hide the review queue">
                        <TextBlock x:Name="ReviewToggleIcon"
                                   Classes="icon"
                                   FontSize="18"
                                   Text="{x:Static controls:Symbols.RightPanelClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =========================================================== sidebar -->
        <Border Grid.Row="1" Grid.Column="0"
                x:Name="SidebarPanel"
                MinWidth="220"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,2*,Auto,*,Auto">
                <TextBox Grid.Row="0"
                         Margin="12,12,12,8"
                         Padding="32,6,9,6"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         Watermark="Search text or tag:name"
                         KeyDown="OnSearchKeyDown">
                    <TextBox.InnerLeftContent>
                        <TextBlock Classes="icon"
                                   FontSize="15"
                                   Margin="10,0,0,0"
                                   Text="{x:Static controls:Symbols.Search}"
                                   Foreground="{DynamicResource FaintBrush}"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <TextBlock Grid.Row="1"
                           Text="{Binding ListHeader}"
                           Classes="section"
                           Margin="16,4,14,6"/>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                         ItemTemplate="{StaticResource NoteRowTemplate}"
                         Margin="6,0"/>

                <TextBlock Grid.Row="3"
                           Text="PAPERS"
                           Classes="section"
                           Margin="16,12,14,6"/>

                <ListBox Grid.Row="4"
                         ItemsSource="{Binding Documents}"
                         SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                         ItemTemplate="{StaticResource DocumentRowTemplate}"
                         Margin="6,0"/>

                <TextBlock Grid.Row="5"
                           Text="{Binding CountsSummary}"
                           Classes="meta"
                           FontSize="10.5"
                           Margin="16,10"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1"
                      x:Name="SidebarSplitter"
                      Background="Transparent"
                      ResizeDirection="Columns"/>

        <!-- ============================================================ views -->
        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*">

            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="nav"
                                Classes.active="{Binding IsGraphView}"
                                Command="{Binding ShowGraphCommand}"
                                ToolTip.Tip="Graph view">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.Hub}"/>
                                <TextBlock Text="Graph"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav"
                                Classes.active="{Binding IsEditorView}"
                                Command="{Binding ShowEditorCommand}"
                                ToolTip.Tip="Note editor">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.EditNote}"/>
                                <TextBlock Text="Note"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav"
                                Classes.active="{Binding IsReaderView}"
                                Command="{Binding ShowReaderCommand}"
                                ToolTip.Tip="Paper reader">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.MenuBook}"/>
                                <TextBlock Text="Reader"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="nav"
                                Classes.active="{Binding IsChatView}"
                                Command="{Binding ShowChatCommand}"
                                ToolTip.Tip="Idea-Craft: ask your vault a question">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.Psychology}"/>
                                <TextBlock Text="Idea-Craft"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding GraphSummary}"
                               Classes="meta"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsGraphView}"/>

                    <TextBlock Grid.Column="2"
                               Text="Working…"
                               Classes="meta"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsBusy}"/>
                </Grid>
            </Border>

            <views:GraphView Grid.Row="1"/>
            <views:NoteView Grid.Row="1" x:Name="NoteEditor"/>
            <views:ReaderView Grid.Row="1"/>
            <views:ChatView Grid.Row="1"/>
            <views:SettingsView Grid.Row="1"/>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="3"
                      x:Name="ReviewSplitter"
                      Background="Transparent"
                      ResizeDirection="Columns"/>

        <!-- ====================================================== right panel -->
        <Border Grid.Row="1" Grid.Column="4"
                x:Name="ReviewPanel"
                MinWidth="240"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="14,14,14,10" Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="REVIEW QUEUE" Classes="section" VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="{DynamicResource AccentDarkBrush}"
                                CornerRadius="9"
                                Padding="7,1"
                                MinWidth="20">
                            <TextBlock Text="{Binding PendingCount}"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="Suggestions wait here. Nothing touches your graph until you accept it."
                               Classes="meta"
                               FontSize="10.5"
                               TextWrapping="Wrap"/>
                    <Button Classes="ghost"
                            FontSize="11"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            Command="{Binding SuggestConnectionsCommand}"
                            ToolTip.Tip="Look for related notes and tags; everything lands in the queue for review">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon"
                                       FontSize="14"
                                       Text="{x:Static controls:Symbols.AutoAwesome}"/>
                            <TextBlock Text="Find connections"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Suggestions}" Margin="12,0,12,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SuggestionRowViewModel">
                                <Border Background="{DynamicResource PanelAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="11,10"
                                        Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="9.5"
                                                       LetterSpacing="1"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding AgeLabel}"
                                                       Classes="meta"
                                                       FontSize="10"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   IsVisible="{Binding HasDetail}"
                                                   Classes="meta"
                                                   FontSize="10.5"
                                                   FontStyle="Italic"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="primary"
                                                    FontSize="11"
                                                    Padding="10,3"
                                                    Command="{Binding AcceptCommand}"
                                                    ToolTip.Tip="Accept this suggestion into the graph">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="icon"
                                                               FontSize="14"
                                                               Text="{x:Static controls:Symbols.Check}"
                                                               Foreground="{DynamicResource OnAccentBrush}"/>
                                                    <TextBlock Text="Accept"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="ghost"
                                                    FontSize="11"
                                                    Padding="10,3"
                                                    Command="{Binding RejectCommand}"
                                                    ToolTip.Tip="Reject this suggestion">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Classes="icon"
                                                               FontSize="14"
                                                               Text="{x:Static controls:Symbols.Close}"/>
                                                    <TextBlock Text="Reject"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10"
                        MaxHeight="220">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="ACTIVITY" Classes="section" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuditRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Detail}"
                                                       FontSize="10.5"
                                                       Classes="muted"
                                                       Margin="6,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FaintBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
