<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Kampf.Views.NoteView"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsEditorView}">

    <!-- Note workspace: title, tags and one body panel shared by editor and preview. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ============ HEADER ============ -->
        <Border Grid.Row="0"
                Padding="24,16,24,12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="8">
                <!-- Title row: title + dirty indicator + primary actions -->
                <Grid ColumnDefinitions="*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Classes="title"
                                 Text="{Binding EditorTitle, Mode=TwoWay}"
                                 Watermark="Untitled note"/>
                        <TextBlock Grid.Column="1"
                                   Classes="dirty"
                                   Text="● unsaved"
                                   IsVisible="{Binding IsDirty}"
                                   ToolTip.Tip="Changes not yet saved"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <!-- Open source: secondary action, sits beside Save so it's
                             discoverable in the same action group. -->
                        <Button Classes="ghost"
                                Command="{Binding OpenSourceCommand}"
                                IsVisible="{Binding CanOpenSource}"
                                ToolTip.Tip="Open the source paper">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.OpenInNew}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Open source"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="primary"
                                Command="{Binding SaveNoteCommand}"
                                IsEnabled="{Binding HasActiveNote}"
                                ToolTip.Tip="Save note (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.Save}"
                                           Foreground="{DynamicResource OnAccentBrush}"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="ghost danger"
                                Command="{Binding DeleteNoteCommand}"
                                IsVisible="{Binding HasActiveNote}"
                                ToolTip.Tip="Delete this note (click twice to confirm)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="16"
                                           Text="{x:Static controls:Symbols.Delete}"
                                           Foreground="{DynamicResource DangerBrush}"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Confirmation hint: pull it out of the button row so it doesn't shift layout. -->
                <TextBlock Text="Click Delete again to confirm"
                           Classes="meta"
                           FontSize="10.5"
                           Foreground="{DynamicResource WarnBrush}"
                           IsVisible="{Binding ConfirmDelete}"/>

                <!-- Provenance row: citation on the left, editor bookkeeping on the right.
                     "Open source" now lives in the header action group above. -->
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProvenanceText}"
                               Classes="meta"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ProvenanceText}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding EditorMeta}"
                               Classes="meta"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding EditorMeta}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ TAGS + PREVIEW TOGGLE ============ -->
        <Border Grid.Row="1" Padding="24,10" IsVisible="{Binding HasActiveNote}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="TAGS" Classes="section" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding EditorTags, Mode=TwoWay}"
                         Watermark="methods, graph-theory (comma separated)"
                         FontSize="11.5"
                         Margin="10,0,0,0"
                         CornerRadius="6"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding BacklinksText}"
                           Classes="meta"
                           VerticalAlignment="Center"
                           Margin="14,0"
                           TextTrimming="CharacterEllipsis"/>
                <ToggleButton Grid.Column="3"
                              x:Name="PreviewToggle"
                              Classes="preview"
                              IsChecked="False"
                              IsCheckedChanged="OnPreviewToggleChanged"
                              ToolTip.Tip="Switch the note body between the editor and the rendered markdown">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon"
                                   FontSize="15"
                                   Text="{x:Static controls:Symbols.Visibility}"/>
                        <TextBlock Text="Preview"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- ============ BODY (editor / preview) ============ -->
        <Grid Grid.Row="2" Margin="24,8,24,16">
            <TextBox x:Name="BodyEditor"
                     Classes="body"
                     Text="{Binding EditorBody, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Watermark="Write markdown. Use [[Another Note]] to connect ideas."/>

            <Border x:Name="PreviewPane"
                    IsVisible="False"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <ScrollViewer>
                    <ContentControl x:Name="PreviewHost"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ EMPTY STATE ============ -->
        <Border Grid.Row="2"
                IsVisible="{Binding !HasActiveNote}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Classes="icon"
                           FontSize="44"
                           HorizontalAlignment="Center"
                           Text="{x:Static controls:Symbols.Notes}"
                           Foreground="{DynamicResource FaintBrush}"/>
                <TextBlock Text="No note selected"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Pick a note on the left, or create a new one."
                           Classes="muted"
                           HorizontalAlignment="Center"/>
                <Button Classes="primary"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Command="{Binding NewNoteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon"
                                   FontSize="16"
                                   Text="{x:Static controls:Symbols.NoteAdd}"
                                   Foreground="{DynamicResource OnAccentBrush}"/>
                        <TextBlock Text="Create note"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,8">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11.5"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>