<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Kampf.Views.DataSharingView"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsDataSharingView}">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="24,16,24,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Text="{x:Static controls:Symbols.Backup}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="PUBLISH &amp; BACKUP" Classes="section" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="A backup is one verified file. A publish is a folder of static HTML. Neither leaves this machine unless you copy it."
                           Classes="meta"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,18,24,28" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

                <!-- ================================================ backup -->
                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon"
                                       FontSize="15"
                                       Text="{x:Static controls:Symbols.Backup}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="BACKUP" Classes="section" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Classes="meta"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="Writes a complete, date-stamped copy of the database to the backups folder and checks it before reporting success. An encrypted vault produces an encrypted backup. Restore a backup only while Kampf is closed."/>

                        <TextBlock Text="{Binding LastBackupLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding BackupNowCommand}"
                                    IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="icon"
                                               FontSize="15"
                                               Text="{x:Static controls:Symbols.Backup}"/>
                                    <TextBlock Text="Back up now"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost"
                                    Content="Open vault folder"
                                    Command="{Binding OpenVaultFolderCommand}"
                                    AutomationProperties.Name="Open vault folder"/>
                        </StackPanel>

                        <TextBlock Text="{Binding BackupMessage}"
                                   IsVisible="{Binding HasBackupMessage}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BackupError}"
                                   IsVisible="{Binding HasBackupError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- =============================================== publish -->
                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon"
                                       FontSize="15"
                                       Text="{x:Static controls:Symbols.OpenInNew}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="PUBLISH" Classes="section" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Classes="meta"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="Write every note and paper as a static HTML site into a folder you choose. Wikilinks keep working, papers keep their citations and the notes taken from them. Nothing is uploaded; the vault stays where it is."/>

                        <Button Command="{Binding PublishCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="15"
                                           Text="{x:Static controls:Symbols.OpenInNew}"/>
                                <TextBlock Text="Publish static copy..."/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding SettingsMessage}"
                                   IsVisible="{Binding HasSettingsMessage}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SettingsError}"
                                   IsVisible="{Binding HasSettingsError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ================================================ storage -->
                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon"
                                       FontSize="15"
                                       Text="{x:Static controls:Symbols.Folder}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="WHAT IS ON DISK" Classes="section" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Vault folder" Classes="meta" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VaultFolder}" FontSize="12" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Database" Classes="meta" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseFile}" FontSize="12" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Backups" Classes="meta" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BackupFolder}" FontSize="12" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Markdown mirrors" Classes="meta" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NotesFolder}" FontSize="12" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Protection" Classes="meta" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EncryptionStatus}" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>

                        <TextBlock Classes="meta"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   Text="Status: no cloud account is connected. Syncing between machines is not part of this build; copy the vault folder or a backup to a drive you control."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
