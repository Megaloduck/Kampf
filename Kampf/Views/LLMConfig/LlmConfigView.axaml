<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
             x:Class="Kampf.Views.LlmConfigView"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsLlmConfigView}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: what this page decides, and what is answering right now. -->
        <Border Grid.Row="0"
                Padding="28,18,28,16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Classes="icon"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Text="{x:Static controls:Symbols.Handyman}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="LLM CONFIGURATION" Classes="section" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Everything on this page runs on this machine. Pick what answers: a model the app downloads and runs itself, or a local server."
                               Classes="meta"
                               FontSize="10.5"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="11,7"
                        MaxWidth="300"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding ChatModelLabel}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ANSWERING" Classes="section" FontSize="8.5"/>
                        <TextBlock Text="{Binding ChatModelLabel}"
                                   FontSize="10.5"
                                   MaxWidth="270"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="28,18,28,32" Spacing="16" HorizontalAlignment="Left">

                <!-- This machine -->

                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,16">
                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="THIS MACHINE" Classes="section" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Padding="12,4"
                                    FontSize="10.5"
                                    Command="{Binding EstimateModelFitCommand}"
                                    ToolTip.Tip="Scan memory again and size the model named below">
                                <TextBlock Text="Scan again"/>
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding HardwareCores}"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="LOGICAL CORES" Classes="meta" FontSize="9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding HardwareMemory}"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="TOTAL MEMORY" Classes="meta" FontSize="9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="{Binding HardwareFreeMemory}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           ToolTip.Tip="Memory the operating system reports as free right now"/>
                                <TextBlock Text="FREE NOW" Classes="meta" FontSize="9"/>
                            </StackPanel>
                        </Grid>

                        <!-- The fit of the model named below, measured without
                             downloading it. -->
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="MODEL FIT" Classes="section" FontSize="9"/>

                                <TextBlock Text="{Binding ModelFitSummary}"
                                           IsVisible="{Binding HasModelFitSummary}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           LineHeight="17"/>

                                <TextBlock Text="Press Scan again to size the model named below."
                                           IsVisible="{Binding !HasModelFitSummary}"
                                           Classes="meta"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding ModelRecommendation}"
                                           Classes="meta"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"
                                           LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <Button Classes="primary"
                                Padding="14,5"
                                FontSize="11"
                                HorizontalAlignment="Left"
                                Command="{Binding UseRecommendedModelCommand}"
                                ToolTip.Tip="Fill in the model this machine can run well">
                            <TextBlock Text="Use recommended model"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Model sources -->

                <Grid ColumnDefinitions="*,*">

                    <Border Grid.Column="0"
                            Margin="0,0,8,0"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,16"
                            VerticalAlignment="Top">
                        <StackPanel Spacing="9">
                            <TextBlock Text="RUN A MODEL HERE" Classes="section"/>
                            <TextBlock Text="Downloads a GGUF from Hugging Face into the vault and runs it inside this app."
                                       Classes="meta"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>

                            <TextBlock Text="Repository" FontSize="11" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding HuggingFaceRepo, Mode=TwoWay}"
                                     Watermark="Insert HuggingFace Repository link"
                                     FontSize="11.5"
                                     Padding="8,6"/>

                            <TextBlock Text="GGUF file" FontSize="11" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding HuggingFaceFile, Mode=TwoWay}"
                                     Watermark="Insert GGUF file"
                                     FontSize="11.5"
                                     Padding="8,6"/>

                            <Button Classes="primary"
                                    Padding="14,5"
                                    FontSize="11"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    IsEnabled="{Binding !IsDownloadingModel}"
                                    Command="{Binding DownloadHuggingFaceModelCommand}">
                                <TextBlock Text="Download &amp; use"/>
                            </Button>

                            <TextBlock Text="{Binding HuggingFaceStatus}"
                                       IsVisible="{Binding HasHuggingFaceStatus}"
                                       Classes="meta"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>

                            <TextBlock Text="A repository and file, or a file URL copied from the model page. Downloads resume after an interruption."
                                       Classes="meta"
                                       FontSize="9.5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            Background="{DynamicResource PanelAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,16"
                            VerticalAlignment="Top">
                        <StackPanel Spacing="9">
                            <TextBlock Text="CONNECT A LOCAL SERVER" Classes="section"/>
                            <TextBlock Text="LM Studio, llama.cpp or Ollama already running on this machine."
                                       Classes="meta"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>

                            <TextBlock Text="Server URL" FontSize="11" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding ChatServerUrl, Mode=TwoWay}"
                                     Watermark="http://localhost:1234/v1"
                                     FontSize="11.5"
                                     Padding="8,6"/>

                            <TextBlock Text="Model" FontSize="11" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding ChatModelName, Mode=TwoWay}"
                                     Watermark="model the server serves"
                                     FontSize="11.5"
                                     Padding="8,6"/>

                            <CheckBox Content="This is an Ollama server"
                                      IsChecked="{Binding ChatUsesOllama, Mode=TwoWay}"
                                      FontSize="10.5"
                                      ToolTip.Tip="The URL then stays as typed, e.g. http://localhost:11434"/>

                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Classes="primary"
                                        Padding="12,5"
                                        FontSize="10.5"
                                        Margin="0,0,8,6"
                                        Command="{Binding ApplyChatModelCommand}">
                                    <TextBlock Text="Apply"/>
                                </Button>
                                <Button Classes="ghost"
                                        Padding="10,5"
                                        FontSize="10.5"
                                        Margin="0,0,8,6"
                                        Command="{Binding DetectChatModelsCommand}"
                                        ToolTip.Tip="Ask the server which models it serves">
                                    <TextBlock Text="Detect"/>
                                </Button>
                                <Button Classes="ghost"
                                        Padding="10,5"
                                        FontSize="10.5"
                                        Margin="0,0,8,6"
                                        Command="{Binding CheckChatModelCommand}"
                                        ToolTip.Tip="Check that the configured model is reachable">
                                    <TextBlock Text="Check"/>
                                </Button>
                                <Button Classes="ghost"
                                        Padding="10,5"
                                        FontSize="10.5"
                                        Margin="0,0,8,6"
                                        Command="{Binding ClearChatModelCommand}"
                                        ToolTip.Tip="Forget the server and answer with the cited passages">
                                    <TextBlock Text="Clear"/>
                                </Button>
                            </WrapPanel>

                            <ItemsControl ItemsSource="{Binding ChatModelChoices}"
                                          IsVisible="{Binding HasChatModelChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatModelChoiceViewModel">
                                        <Button Classes="link"
                                                Margin="0,0,12,4"
                                                Command="{Binding UseCommand}"
                                                ToolTip.Tip="Use this model">
                                            <TextBlock Text="{Binding Name}" FontSize="10.5"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding ChatModelHealth}"
                                       IsVisible="{Binding HasChatModelHealth}"
                                       Classes="meta"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Active models -->

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14">
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="EMBEDDINGS" Classes="section" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding EmbeddingLabel}"
                                   Classes="meta"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1"
                                   Text="ANSWERING"
                                   Classes="section"
                                   FontSize="9"
                                   Margin="0,6,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding ChatModelLabel}"
                                   Classes="meta"
                                   FontSize="10.5"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <TextBlock Text="Downloaded weights live in the vault's models folder and are the only network use on this page. Server fields fall back to KAMPF_CHAT_URL / KAMPF_OLLAMA_URL when empty; embeddings use KAMPF_EMBEDDING_MODEL."
                           Classes="meta"
                           FontSize="10"
                           TextWrapping="Wrap"
                           LineHeight="16"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
