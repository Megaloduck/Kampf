<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kampf.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Kampf.Views"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="880"
        x:Class="Kampf.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource BgBrush}"
        Title="Kampf"
        Width="1420" Height="900"
        MinWidth="1024" MinHeight="640">
    <!-- A maximized window drawn without system chrome hangs its border off the
         screen, so the shell follows the off-screen margin: maximized, the
         header and its caption buttons sit on the screen edge instead of being
         clipped by it. Zero at any other size, and on every other platform. -->
    <Panel Margin="{Binding $parent[Window].OffScreenMargin}">
        <views:MainView x:Name="RootView" />
        <!-- Shown instead of the shell until an encrypted vault is unlocked. -->
        <views:UnlockView x:Name="LockView" />
    </Panel>
</Window>
