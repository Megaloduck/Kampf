<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kampf.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Kampf.Views"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="880"
        x:Class="Kampf.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{DynamicResource BgBrush}"
        Title="Kampf"
        Width="1420" Height="900"
        MinWidth="1024" MinHeight="640">
    <views:MainView x:Name="RootView" />
</Window>
