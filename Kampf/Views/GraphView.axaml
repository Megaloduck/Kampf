<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Kampf.Views.GraphView"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsGraphView}">

    <!-- Graph workspace: filters, canvas and the vault path. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox Width="126"
                          ItemsSource="{Binding SourceFilters}"
                          SelectedItem="{Binding SourceFilter, Mode=TwoWay}"
                          ToolTip.Tip="Show notes only, papers only, or both"/>
                <ComboBox Width="130"
                          ItemsSource="{Binding TagFilters}"
                          SelectedItem="{Binding TagFilter, Mode=TwoWay}"
                          ToolTip.Tip="Keep only notes carrying this tag"/>
                <ComboBox Width="112"
                          ItemsSource="{Binding YearFilters}"
                          SelectedItem="{Binding YearFilter, Mode=TwoWay}"
                          ToolTip.Tip="Keep papers of one year and the notes taken from them"/>
                <ComboBox Width="140"
                          ItemsSource="{Binding AuthorFilters}"
                          SelectedItem="{Binding AuthorFilter, Mode=TwoWay}"
                          ToolTip.Tip="Keep papers by one author and the notes taken from them"/>
                <CheckBox Content="Unreviewed"
                          IsChecked="{Binding UnreviewedOnly, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Show only the notes the review queue is asking about"/>
                <TextBlock Text="Click to inspect · double-click to open · drag to arrange · scroll to zoom"
                           Classes="meta"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <controls:GraphControl Grid.Row="1"
                               x:Name="GraphCanvas"
                               GraphSource="{Binding Graph}"
                               SelectedNodeId="{Binding SelectedNodeId}"/>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="18,0,18,10">
            <TextBlock Text="{Binding VaultPath}"
                       Classes="meta"
                       FontSize="10"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding GraphSummary}"
                       Classes="meta"
                       FontSize="10"/>
        </Grid>
    </Grid>
</UserControl>
