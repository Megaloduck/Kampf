<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kampf.ViewModels"
             xmlns:controls="using:Kampf.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Kampf.Views.DataSharingView"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsDataSharingView}">

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="24,16,24,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Text="{x:Static controls:Symbols.CloudSync}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="DATA SHARING AND CONNECTION" Classes="section" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="What leaves the vault, and what does not. Publishing writes files you choose; there is no account and no upload."
                           Classes="meta"
                           FontSize="10.5"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,18,24,28" Spacing="14" MaxWidth="820" HorizontalAlignment="Left">

                <!-- =============================================== publish -->
                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon"
                                       FontSize="15"
                                       Text="{x:Static controls:Symbols.OpenInNew}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="PUBLISH" Classes="section" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Classes="meta"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   Text="Write every note and paper as a static HTML site into a folder you choose. Wikilinks between notes keep working, papers keep their citation and the notes taken from them. Nothing is uploaded; the vault stays where it is."/>

                        <Button Command="{Binding PublishCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon"
                                           FontSize="15"
                                           Text="{x:Static controls:Symbols.OpenInNew}"/>
                                <TextBlock Text="Publish static copy..."/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding SettingsMessage}"
                                   IsVisible="{Binding HasSettingsMessage}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SettingsError}"
                                   IsVisible="{Binding HasSettingsError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ============================================ connection -->
                <Border Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon"
                                       FontSize="15"
                                       Text="{x:Static controls:Symbols.CloudSync}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="CONNECTION" Classes="section" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Classes="meta"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   Text="No remote is connected. The vault is a folder on this machine; copying or backing it up is a file operation you control, and syncing between machines is not part of this build."/>

                        <StackPanel Spacing="2">
                            <TextBlock Text="VAULT FOLDER" Classes="section" FontSize="9.5"/>
                            <TextBlock Text="{Binding VaultFolder}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="DATABASE" Classes="section" FontSize="9.5" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding DatabaseFile}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="MARKDOWN MIRRORS" Classes="section" FontSize="9.5" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding NotesFolder}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="{Binding EncryptionStatus}"
                                   Classes="meta"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
