<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Kampf"
             x:Class="Kampf.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="MaterialSymbols">avares://Kampf/Assets/Fonts#Material Symbols Rounded</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgBrush" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#11151D"/>
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#151A24"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#222A38"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2E3749"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#E4E8F1"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#8C94AC"/>
                    <SolidColorBrush x:Key="FaintBrush" Color="#5A6178"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#8FA6FF"/>
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2A3350"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#A6B8FF"/>
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="WarnBrush" Color="#FFC66D"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#54C6A3"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#E06B8B"/>
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#4A2A38"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#1B2130"/>
                    <SolidColorBrush x:Key="SelectedBrush" Color="#1E2637"/>
                    <SolidColorBrush x:Key="InputBrush" Color="#0F131B"/>
                    <SolidColorBrush x:Key="CodeBrush" Color="#F0B27A"/>
                    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#141821"/>
                    <SolidColorBrush x:Key="RuleBrush" Color="#262C3A"/>
                    <SolidColorBrush x:Key="QuoteBorderBrush" Color="#3A4A56"/>
                    <SolidColorBrush x:Key="GraphCanvasBrush" Color="#0E1118"/>
                    <SolidColorBrush x:Key="GraphLabelBrush" Color="#D7DCEA"/>
                    <SolidColorBrush x:Key="GraphMutedBrush" Color="#5A6178"/>
                    <SolidColorBrush x:Key="GraphEdgeManualBrush" Color="#3D465C"/>
                    <SolidColorBrush x:Key="GraphEdgeWikiBrush" Color="#4C5876"/>
                    <SolidColorBrush x:Key="GraphEdgeAcceptedBrush" Color="#A78BFA"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgBrush" Color="#F6F7FB"/>
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PanelAltBrush" Color="#F0F2F8"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#DDE2EC"/>
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C6CEDD"/>
                    <SolidColorBrush x:Key="TextBrush" Color="#12151C"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#5C6478"/>
                    <SolidColorBrush x:Key="FaintBrush" Color="#8A92A6"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#4C63C9"/>
                    <SolidColorBrush x:Key="AccentDarkBrush" Color="#DDE3FA"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3E55BD"/>
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="WarnBrush" Color="#A96800"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#1F8A6A"/>
                    <SolidColorBrush x:Key="DangerBrush" Color="#B93B5B"/>
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F0CBD6"/>
                    <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F8"/>
                    <SolidColorBrush x:Key="SelectedBrush" Color="#E3E8F5"/>
                    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CodeBrush" Color="#A14A00"/>
                    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F3F4F8"/>
                    <SolidColorBrush x:Key="RuleBrush" Color="#E2E6EF"/>
                    <SolidColorBrush x:Key="QuoteBorderBrush" Color="#C3CBD9"/>
                    <SolidColorBrush x:Key="GraphCanvasBrush" Color="#FBFBFD"/>
                    <SolidColorBrush x:Key="GraphLabelBrush" Color="#2A3040"/>
                    <SolidColorBrush x:Key="GraphMutedBrush" Color="#8A92A6"/>
                    <SolidColorBrush x:Key="GraphEdgeManualBrush" Color="#B9C1D0"/>
                    <SolidColorBrush x:Key="GraphEdgeWikiBrush" Color="#9AA5BC"/>
                    <SolidColorBrush x:Key="GraphEdgeAcceptedBrush" Color="#7A5BD0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Every app style lives in one file; it is included after FluentTheme so
             its setters win over the theme's own. -->
        <StyleInclude Source="avares://Kampf/Assets/Styles/Styles.axaml"/>
    </Application.Styles>
</Application>
